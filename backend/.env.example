#Configurazione generale dell'applicazione
APP_NAME="Vehicle Rental Manager"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

#Impostazioni linguistiche
APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=it_IT

#Gestione della modalità manutenzione
APP_MAINTENANCE_DRIVER=file
#APP_MAINTENANCE_STORE=database

#Numero di processi del server PHP locale
#PHP_CLI_SERVER_WORKERS=4

#Numero di iterazioni usate per proteggere le password
BCRYPT_ROUNDS=12

#Configurazione dei log
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

#Configurazione del database MySQL
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=autonoleggio
DB_USERNAME=root
DB_PASSWORD=

#Configurazione delle sessioni
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

#Nome e sicurezza del cookie di autenticazione
SESSION_COOKIE=vehicle_rental_manager_session
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

#Indirizzi considerati appartenenti alla nostra applicazione
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8000

#Configurazione dei servizi interni
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database
#CACHE_PREFIX=

#Configurazione Redis
MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

#Le email vengono scritte nei log durante lo sviluppo
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@vehicle-rental-manager.test"
MAIL_FROM_NAME="${APP_NAME}"

#Configurazione opzionale per lo spazio di archiviazione AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
